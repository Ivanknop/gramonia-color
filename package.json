{
  "name": "colores-de-gramonia",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.26",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "format": "prettier --write .",
    "typecheck": "npm run tipos-rutas && tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "doctor": "expo-doctor",
    "cuadros": "node scripts/compilar-cuadros.mjs",
    "cuadros:check": "node scripts/compilar-cuadros.mjs --check",
    "verificar": "npm run cuadros:check && npm run typecheck && npm run lint && npm test && npm run test:scripts",
    "tipos-rutas": "node scripts/generar-tipos-rutas.mjs",
    "test:scripts": "python3 -m unittest discover -s scripts -p \"test_*.py\"",
    "imagen-a-cuadro": "python3 scripts/imagen_a_cuadro.py"
  },
  "private": true,
  "allowScripts": {
    "@parcel/watcher": false
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "resolver": "<rootDir>/jest.resolver.js",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup-after-env.js"
    ]
  }
}
